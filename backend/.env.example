# --- SERVER CONFIG ---
PORT=5000
NODE_ENV=production

# --- SECURITY ---
JWT_SECRET=your_super_secret_jwt_key
CLIENT_URL=http://localhost:5173,https://your-production-app.com

# --- DATABASE & CACHE ---
# For local dev: mongodb://localhost:27017/videosync
# For Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/videosync
MONGODB_URI=mongodb://localhost:27017/videosync

# Scaling: Required for horizontal cluster sync
REDIS_URL=redis://localhost:6379

# --- MEDIA (CLOUDINARY) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
